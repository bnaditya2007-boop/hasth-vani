# Hindsight server URL.
# Hosted Hindsight: use the URL from your Hindsight deployment.
# Self-hosted Hindsight: commonly http://localhost:8888
HINDSIGHT_BASE_URL=http://localhost:8888

# API key, if your Hindsight deployment requires one.
HINDSIGHT_API_KEY=

# A stable memory bank for this project.
HINDSIGHT_BANK_ID=hasth-vani

# Keep API requests short enough for a local engineering tool.
HINDSIGHT_TIMEOUT_SECONDS=15
